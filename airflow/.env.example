# Copy to airflow/.env (git-ignored) and fill in. Never commit real values.
SNOWFLAKE_ACCOUNT=<org-account>
SNOWFLAKE_USER=<service-user>
SNOWFLAKE_ROLE=DBT_CI_ROLE
SNOWFLAKE_WAREHOUSE=<warehouse>
SNOWFLAKE_DATABASE=AIRBNB_CI
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<passphrase>
# Host path to the private key file (forward slashes on Windows, e.g. C:/Users/me/keys/dbt_ci.p8)
SNOWFLAKE_PRIVATE_KEY_FILE=<path-to-private-key.p8>
# Builds into AIRBNB_CI schemas AIRFLOW_BRONZE, AIRFLOW_SILVER, AIRFLOW_GOLD
DBT_CI_SCHEMA=AIRFLOW
# Optional https webhook (Slack-compatible) for failure alerts; empty means log only
AIRFLOW_ALERT_WEBHOOK_URL=
